generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["ecms"]
}

model account {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String    @db.Uuid
  account_id               String
  provider_id              String
  access_token             String?
  refresh_token            String?
  access_token_expires_at  DateTime? @db.Timestamptz(6)
  refresh_token_expires_at DateTime? @db.Timestamptz(6)
  scope                    String?
  id_token                 String?
  password                 String?
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @db.Timestamptz(6)
  user                     user      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider_id, account_id], map: "uq_account_provider_uid")
  @@index([user_id], map: "ix_account_user")
  @@schema("ecms")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_findings {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id          String            @db.Uuid
  finding_type        String
  subject_type        String
  subject_id          String            @db.Uuid
  severity            issue_severity    @default(medium)
  score               Decimal?          @db.Decimal(9, 8)
  title               String
  explanation         String
  evidence            Json              @default("{}")
  model_provider      String
  model_name          String
  model_version       String?
  prompt_version      String?
  input_snapshot_hash String?           @db.Char(64)
  status              ai_finding_status @default(open)
  reviewed_by         String?           @db.Uuid
  reviewed_at         DateTime?         @db.Timestamptz(6)
  review_notes        String?
  converted_issue_id  String?           @db.Uuid
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @default(now()) @db.Timestamptz(6)
  row_version         BigInt            @default(1)
  issues              issues?           @relation(fields: [converted_issue_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projects            projects          @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_users           app_users?        @relation(fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id, status, severity, created_at(sort: Desc)], map: "ix_ai_findings_worklist")
  @@schema("ecms")
}

